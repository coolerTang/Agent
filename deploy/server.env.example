POSTGRES_PASSWORD=replace-with-strong-password
# URL-encode special characters in the password. Internal Docker host is postgres.
DATABASE_URL=postgresql://agent:replace-with-strong-password@postgres:5432/agent_db?schema=public
VECTOR_MEMORY_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://api.siliconflow.cn/v1
IMAGE_GENERATION_MODEL=Qwen/Qwen-Image
# Optional services must be reachable from the API container, not localhost.
OLLAMA_NATIVE_BASE_URL=http://host.docker.internal:11434
SEARXNG_BASE_URL=http://searxng:8080
WEATHER_API_KEY=
